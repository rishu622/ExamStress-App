# Copy to .env (local) or set these in your hosting provider's environment settings.

ENVIRONMENT=production

# REQUIRED in production: a long random secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Database. PostgreSQL is recommended in production (most hosts give you a URL).
# SQLite works for a single server ONLY if the file is on a persistent disk:
#   DATABASE_URL=sqlite:////data/examstress.db
DATABASE_URL=

# First administrator, created on first start if no admin exists. Remove the password afterwards.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=School Administrator

# Leave empty when the app and API are served from the same domain (the default deployment).
CORS_ORIGINS=

# Optional: e-mail critical/high alerts to counselors.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
